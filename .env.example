# Copy this file to .env and replace the placeholder values with your own local secrets.
# Never commit .env to Git.

# PostgreSQL setting
LIBRARY_DB_PASSWORD=change-me-db-password

# Security
SPRING_PROFILES_ACTIVE=local
# Base64-encoded 256-bit (32-byte) secret for HS256 JWT signing
# Generate one with: openssl rand -base64 32
LIBRARY_JWT_SECRET_BASE64=replace-with-base64-encoded-32-byte-secret

# Local admin setup
LIBRARY_ADMIN_EMAIL=admin@library.local
LIBRARY_ADMIN_PASSWORD=change-me-admin-password

# Optional circulation policy overrides
APP_MAX_ACTIVE_LOANS=5
APP_DAILY_FINE_RATE=0.50
APP_FINE_BLOCK_THRESHOLD=10.00
APP_DUE_SOON_DAYS=2

# Optional SMTP / Mailpit email alerts
LIBRARY_EMAIL_ENABLED=false
LIBRARY_EMAIL_FROM=no-reply@athenaeum.local
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025

# Isolated staging: use compose.staging.yaml with a separate external env file.
# This profile never bootstraps a default administrator.
STAGING_HTTP_PORT=3100
# Production datasource values are supplied by Compose; do not expose PostgreSQL ports.
